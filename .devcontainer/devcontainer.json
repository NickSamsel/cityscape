{
  "name": "cityscape",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/cityscape",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbt-labs.dbt-bitbucket-adapter",
        "Anthropic.claude-code"
      ]
    }
  }
}